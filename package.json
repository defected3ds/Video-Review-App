    "test:supabase": "node tests/supabase.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test:r2:e2e": "node tests/r2-browser.mjs",
    "test:feedback:e2e": "node tests/feedback-browser.mjs",
    "test:navigation:e2e": "node tests/navigation-browser.mjs",
    "test:sessions:e2e": "node tests/session-browser.mjs",
    "test:edit:e2e": "node tests/edit-browser.mjs",
    "test:theme:e2e": "node tests/theme-browser.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
