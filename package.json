{
  "name": "pipelife-video-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:demo": "node scripts/prepare-demo.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:demo": "npm run prepare:demo && node scripts/build-offline.mjs",
    "start": "node server/index.mjs",
